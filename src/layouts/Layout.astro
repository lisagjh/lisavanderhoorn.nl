---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Header from "../lib/components/display/Header.astro";
import Footer from "../lib/components/display/Footer.astro";
import RevealPage from "../lib/components/display/RevealPage.astro";

const { pageTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="stylesheet" href="/styles/global.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <meta property="og:title" content="Junior Frontend Developer | Lisa van der Hoorn">
    <meta property="og:description" content="Creative junior frontend developer crafting accessible and modern web experiences.">
    <meta property="og:type" content="website">

    <ClientRouter />
    <Analytics />
    <SpeedInsights />
    
  </head>
  <body transition:animate="fade">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
